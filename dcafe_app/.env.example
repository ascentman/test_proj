# Poster API Configuration
# Get these from: https://joinposter.com/manage/integration
POSTER_ACCOUNT_NAME=your_account_name
POSTER_APPLICATION_ID=your_application_id
POSTER_APPLICATION_SECRET=your_application_secret
POSTER_ACCESS_TOKEN=your_access_token

# LiqPay Configuration
# Get these from: https://www.liqpay.ua/
LIQPAY_PUBLIC_KEY=your_liqpay_public_key
LIQPAY_PRIVATE_KEY=your_liqpay_private_key

# Apple Pay Configuration
APPLE_MERCHANT_ID=merchant.com.dcafe.app

# Google Pay Configuration
GOOGLE_GATEWAY_MERCHANT_ID=your_gateway_merchant_id

# App Configuration
APP_NAME=D.Cafe
CURRENCY=UAH
CURRENCY_SYMBOL=₴
